---
import '../caneta/caneta.css';
import type { Figura } from '../caneta/caneta.js';
import {
  caminhoDaPaginaPorUrl,
  renderizarFiguraImpressa,
  resolverArquivoPagina,
  rotuloFigura,
} from '../caneta/figura';

interface Props {
  nome: string;
  legenda?: string;
  largura?: 'texto' | 'larga';
}

const { nome, legenda, largura = 'texto' } = Astro.props;

const locals = Astro.locals as Record<string | symbol, unknown>;
const numero = legenda ? rotuloFigura(locals) : null;

const mapaFiguras = import.meta.glob<{ default: Figura }>('/conteudo/**/figuras/*.js');
const pagina = typeof locals.pastaPagina === 'string' ? locals.pastaPagina : caminhoDaPaginaPorUrl(Astro.url.pathname);

const { chave, valor: carregarFigura } = resolverArquivoPagina({
  tipo: 'figuras',
  arquivo: `${nome}.js`,
  pagina,
  mapa: mapaFiguras,
});

const modulo = await carregarFigura();
const figura = modulo.default;
const { classes, htmlInterno } = renderizarFiguraImpressa(figura);
const origem = figura.origem;

const ROTULOS_AUTORIA: Record<string, string> = {
  ia: 'com IA',
  humano: 'à mão',
  misto: 'à mão e com IA',
};
const textoAutoria = origem?.autoria ? (ROTULOS_AUTORIA[origem.autoria] ?? origem.autoria) : null;
---

<figure class={largura === 'larga' ? 'larga' : undefined}>
  <div class={classes} data-estado="impresso" data-caneta-chave={chave} set:html={htmlInterno} />
  {
    legenda && (
      <figcaption>
        <b>Figura {numero}.</b> {legenda}
      </figcaption>
    )
  }
  {
    origem && (
      <details class="origem-figura">
        <summary>como foi feita</summary>
        <dl class="origem-detalhes">
          {textoAutoria && (
            <div>
              <dt>Autoria</dt>
              <dd>{textoAutoria}</dd>
            </div>
          )}
          {origem.pedido && (
            <div>
              <dt>Pedido</dt>
              <dd>{origem.pedido}</dd>
            </div>
          )}
          {origem.validacao && (
            <div>
              <dt>Validação</dt>
              <dd>{origem.validacao}</dd>
            </div>
          )}
        </dl>
      </details>
    )
  }
</figure>

<style>
  .origem-figura {
    margin-top: 6px;
    max-width: 680px;
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--muted);
  }
  .origem-figura summary {
    cursor: pointer;
    font-family: var(--hand);
    font-size: 18px;
    line-height: 1.2;
    color: var(--muted);
  }
  .origem-figura summary:hover {
    color: var(--ink);
  }
  .origem-detalhes {
    margin: 8px 0 0;
    padding-left: 12px;
    border-left: 1.5px solid var(--rule);
    display: grid;
    gap: 6px;
  }
  .origem-detalhes div {
    display: grid;
    gap: 2px;
  }
  .origem-detalhes dt {
    font-weight: 600;
    color: var(--ink);
  }
  .origem-detalhes dd {
    margin: 0;
  }
</style>

<script>
  import type { Figura } from '../caneta/caneta.js';

  const figurasPublicas = import.meta.glob<{ default: Figura }>([
    '/conteudo/exemplo/**/figuras/*.js',
    '/conteudo/publico/**/figuras/*.js',
  ]);
  const figurasPrivadas = import.meta.env.DEV
    ? import.meta.glob<{ default: Figura }>('/conteudo/privado/**/figuras/*.js')
    : {};
  const todasFiguras: Record<string, () => Promise<{ default: Figura }>> = {
    ...figurasPublicas,
    ...figurasPrivadas,
  };

  async function ativarFigura(el: HTMLElement) {
    const chave = el.dataset.canetaChave;
    if (!chave || el.dataset.canetaMontada === '1') return;
    const carregar = todasFiguras[chave];
    if (!carregar) return;

    el.dataset.canetaMontada = '1';
    const [{ montar }, modFigura] = await Promise.all([import('../caneta/caneta.js'), carregar()]);
    el.removeAttribute('data-estado');
    montar(el, modFigura.default);
  }

  const alvos = document.querySelectorAll<HTMLElement>('[data-caneta-chave]');
  if (alvos.length > 0) {
    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver(
        (entradas) => {
          for (const entrada of entradas) {
            if (!entrada.isIntersecting) continue;
            const alvo = entrada.target as HTMLElement;
            obs.unobserve(alvo);
            void ativarFigura(alvo);
          }
        },
        { rootMargin: '120px 0px', threshold: 0.01 },
      );
      alvos.forEach((alvo) => obs.observe(alvo));
    } else {
      alvos.forEach((alvo) => void ativarFigura(alvo));
    }
  }
</script>
