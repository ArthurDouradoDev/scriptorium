---
/* Bloco recolhido no fim da página mostrando o histórico editorial: etapas,
   autoria ("à mão" ou "com IA"), tamanho das mudanças e diff da revisão com IA. */
import { historicoDaPagina, rotuloEtapa, type MudancaEditorial } from '../conteudo/historico';
import type { EtapaEditorial } from '../conteudo/raizes';

interface Props {
  etapaAtual: EtapaEditorial;
  mudancas?: MudancaEditorial[];
  caminho?: string;
}

const { etapaAtual, mudancas: mudancasProp, caminho } = Astro.props;
const mudancas = mudancasProp ?? (caminho ? historicoDaPagina(caminho) : []);

function formatarData(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  return d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
}

function resumirArquivos(m: MudancaEditorial): string {
  const partes: string[] = [];
  if (m.linhas.adicionadas > 0 || m.linhas.removidas > 0) {
    partes.push(`+${m.linhas.adicionadas} −${m.linhas.removidas} linhas`);
  }
  if (m.arquivos.figuras.length > 0) {
    const n = m.arquivos.figuras.length;
    partes.push(`${n} ${n === 1 ? 'figura' : 'figuras'}`);
  }
  if (m.arquivos.imagens.length > 0) {
    const n = m.arquivos.imagens.length;
    partes.push(`${n} ${n === 1 ? 'imagem' : 'imagens'}`);
  }
  return partes.join(' · ');
}

function parsearLinhasDiff(diff: string): { tipo: 'ctx' | 'add' | 'rem' | 'meta'; texto: string }[] {
  return diff
    .split(/\r?\n/)
    .filter((l) => !l.startsWith('diff --git') && !l.startsWith('index ') && !l.startsWith('--- ') && !l.startsWith('+++ '))
    .map((l) => {
      if (l.startsWith('@@')) return { tipo: 'meta' as const, texto: l };
      if (l.startsWith('+')) return { tipo: 'add' as const, texto: l };
      if (l.startsWith('-')) return { tipo: 'rem' as const, texto: l };
      return { tipo: 'ctx' as const, texto: l };
    });
}
---

<details class="historico">
  <summary>Como esta página foi feita</summary>

  {
    mudancas.length === 0 ? (
      <p class="historico-vazio">
        Etapa atual: <b>{rotuloEtapa(etapaAtual)}</b>. Sem histórico de commits registrado para esta raiz.
      </p>
    ) : (
      <ol class="historico-lista">
        {mudancas.map((m) => {
          const tamanho = resumirArquivos(m);
          return (
            <li class="historico-item">
              <div class="historico-cabecalho">
                <span class="historico-data">{formatarData(m.data)}</span>
                {m.etapa && <span class="historico-etapa">{rotuloEtapa(m.etapa)}</span>}
                <span class:list={['historico-autoria', { 'com-ia': m.comIA }]}>
                  {m.comIA ? 'com IA' : 'à mão'}
                </span>
              </div>
              <div class="historico-corpo">
                <span class="historico-assunto">{m.assunto}</span>
                {tamanho && <span class="historico-tamanho">{tamanho}</span>}
              </div>
              {m.diffTexto && (
                <details class="historico-diff">
                  <summary>ver diff entre rascunho e revisão com IA</summary>
                  <pre class="diff-codigo" data-codigo>
                    <code>
                      {parsearLinhasDiff(m.diffTexto).map((linha) => (
                        <span class={`diff-linha diff-${linha.tipo}`}>
                          {linha.texto}
                          {'\n'}
                        </span>
                      ))}
                    </code>
                  </pre>
                </details>
              )}
            </li>
          );
        })}
      </ol>
    )
  }
</details>

<style>
  .historico {
    border: 1px solid var(--rule);
    border-radius: 14px;
    padding: 12px 18px;
    margin: 48px 0 12px;
  }
  .historico > summary {
    cursor: pointer;
    font-weight: 600;
  }
  .historico-vazio {
    margin: 12px 0 4px;
    font-size: 16px;
    color: var(--muted);
  }
  .historico-lista {
    list-style: none;
    margin: 16px 0 4px;
    padding: 0 0 0 16px;
    border-left: 1.5px solid var(--rule);
    display: grid;
    gap: 16px;
  }
  .historico-item {
    position: relative;
    margin: 0;
  }
  .historico-item::before {
    content: '';
    position: absolute;
    left: -21px;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink);
  }
  .historico-cabecalho {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    line-height: 1.3;
  }
  .historico-data {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .historico-etapa {
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 1px 9px;
    font-size: 13.5px;
  }
  .historico-autoria {
    font-family: var(--hand);
    font-size: 19px;
    line-height: 1;
    color: var(--muted);
  }
  .historico-autoria.com-ia {
    color: var(--ink);
    font-weight: 700;
  }
  .historico-corpo {
    margin-top: 4px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 14px;
    font-size: 16.5px;
  }
  .historico-tamanho {
    font-size: 14.5px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .historico-diff {
    margin-top: 8px;
  }
  .historico-diff summary {
    cursor: pointer;
    font-size: 15px;
    color: var(--muted);
  }
  .historico-diff summary:hover {
    color: var(--ink);
  }
  .diff-codigo {
    margin: 8px 0 0;
    padding: 12px 14px;
    font-size: 13.5px;
    line-height: 1.45;
    max-height: 360px;
    overflow: auto;
  }
  .diff-linha {
    display: block;
  }
  .diff-add {
    background: var(--wash);
    font-weight: 600;
  }
  .diff-rem {
    color: var(--muted);
    text-decoration: line-through;
  }
  .diff-meta {
    color: var(--muted);
    font-style: italic;
  }
</style>
